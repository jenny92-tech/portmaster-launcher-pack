#!/bin/bash
# INPUT:  PortMaster、共享 LÖVE UI、d2r_ns 资源和安装辅助程序
# OUTPUT: 独立 d2r_ns 执行目录、UI 和已验证预设的游戏进程
# POS:    NS 版本专用的 PortMaster 启动与生命周期入口
# PORTMASTER: d2r_ns, Je-暗黑破坏神II_NS.sh
if [ -z "${BASH_VERSION:-}" ]; then
    exec /bin/bash "$0" "$@"
fi
PORT_NAME=d2r_ns
LOG_PREFIX="[D2R-NS]"
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

#@KIT-BEGIN
KIT="$(cd "$(dirname "$0")/../../../_kit" && pwd)"
source "$KIT/portmaster_bootstrap.sh"
source "$KIT/launcher_platform.sh"
source "$KIT/launcher_artwork.sh"
source "$KIT/portmaster_common.sh"
#@KIT-END

portmaster_init "$SCRIPT_DIR" || exit 1
GAMEDIR=${D2R_NS_GAME_DIR:-$SCRIPT_DIR/d2r_ns}
if [ ! -d "$GAMEDIR" ]; then
    GAMEDIR="/$directory/ports/d2r_ns"
fi
GAMEDIR=$(CDPATH= cd -- "$GAMEDIR" && pwd -P) || exit 1
D2R_NS_USER_ROOT=${D2R_NS_USER_DIR:-/userdata/d2r_ns}
D2R_NS_RUNTIME_ROOT=${D2R_NS_RUNTIME_DIR:-$D2R_NS_USER_ROOT/runtime}
D2R_NS_PROFILE_ROOT=${D2R_NS_PROFILE_DIR:-$D2R_NS_USER_ROOT/profile}
installed=$(python3 "$GAMEDIR/libexec/setup_runtime.py" "$GAMEDIR" \
    "$D2R_NS_RUNTIME_ROOT" "$D2R_NS_PROFILE_ROOT") || exit 1
export PORTKIT_LAUNCHER_BIN_OVERRIDE="$installed/bin/portkit-launcher"
export SDL_GAMECONTROLLERCONFIG="$sdl_controllerconfig"
controllers="$controlfolder/gamecontrollerdb.txt"

if [ "${1:-}" = --check ]; then
    /bin/bash "$GAMEDIR/libexec/run-game.sh" "$GAMEDIR" "$installed" \
        "$D2R_NS_PROFILE_ROOT" "$controllers" --check
    exit "$?"
fi

portmaster_sync_launcher_artwork "$SCRIPT_DIR" "$0" "$GAMEDIR"
exec >"$GAMEDIR/log.txt" 2>&1
#@BUILD-LOG
printf '%s\n' "$LOG_PREFIX GAMEDIR=$GAMEDIR"
love_source=$(portkit_launcher runtime latest-love --root "$controlfolder/runtimes") || exit 1
input_source="$controlfolder/gptokeyb"
LAUNCHER_UI_RUNTIME_DIR=$(python3 "$GAMEDIR/libexec/setup_ui_runtime.py" \
    "${love_source%/*}" "$input_source" "$D2R_NS_USER_ROOT/ui-runtime") || exit 1
export LAUNCHER_UI_RUNTIME_DIR
cached_input="$LAUNCHER_UI_RUNTIME_DIR/gptokeyb"
GPTOKEYB=${GPTOKEYB/"$input_source"/$cached_input}
run_love_launcher_ui
trap launcher_platform_finish EXIT
if [ -n "$LAUNCH_ENV" ]; then
    source "$LAUNCH_ENV"
fi
launcher_platform_prepare_game d2r-linux-novideo
d2r_ns_pid=
d2r_ns_stop() {
    if [ -n "$d2r_ns_pid" ]; then
        kill -TERM "$d2r_ns_pid" 2>/dev/null || true
        wait "$d2r_ns_pid" 2>/dev/null || true
    fi
    exit 130
}
trap d2r_ns_stop INT TERM
/bin/bash "$GAMEDIR/libexec/run-game.sh" "$GAMEDIR" "$installed" \
    "$D2R_NS_PROFILE_ROOT" "$controllers" &
d2r_ns_pid=$!
wait "$d2r_ns_pid"
d2r_ns_status=$?
d2r_ns_pid=
exit "$d2r_ns_status"
