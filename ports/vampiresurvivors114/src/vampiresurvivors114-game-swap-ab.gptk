# INPUT:  吹米/PortMaster SDL 手柄事件与交换 AB 的用户设置
# OUTPUT: 交换后的吸血鬼幸存者键盘确认、返回与方向事件
# POS:    仅用于 1.14 游戏阶段的输入兼容，不复用启动器 UI 映射

a = esc
b = enter
start = esc
back = esc

up = up
up = repeat
down = down
down = repeat
left = left
right = right

left_analog_up = up
left_analog_up = repeat
left_analog_down = down
left_analog_down = repeat
left_analog_left = left
left_analog_right = right

repeat_delay = 360
repeat_interval = 90
