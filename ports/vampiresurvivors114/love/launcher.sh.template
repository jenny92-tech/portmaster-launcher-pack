#!/bin/bash
# INPUT:  _kit 启动/Unity 公共库、PortMaster、VS_* 配置、unityloader 及插件
# OUTPUT: 显示所有权交接、图形/按键配置更新与吸血鬼幸存者游戏进程
# POS:    吸血鬼幸存者 1.14 的掌机显示协调和 Unity 6 启动模板
# PORTMASTER: vampiresurvivors114, V_吸血鬼幸存者_114.sh
#
# Stage-1: shared love settings UI writes launch_config.env.
# Stage-2: rewrite config.toml, then run the standard plugin-based unityloader.
# Google Play/GMS behavior is selected independently by unityloader.d plugins.
#
# Critical isolation: love's display env must stay confined to the
# run_love_launcher_ui subshell and never leak into stage-2.

PORT_NAME="vampiresurvivors114"; LOG_PREFIX="[VS114-LOVE]"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# ── PortMaster preamble (controlfolder discovery + control.txt).
# PortMaster discovery follows the official shared path order.
#@KIT-BEGIN
KIT="$(cd "$(dirname "$0")/../../../_kit" && pwd)"
source "$KIT/portmaster_bootstrap.sh"
source "$KIT/launcher_platform.sh"
source "$KIT/launcher_artwork.sh"
#@KIT-END
portmaster_init "$SCRIPT_DIR" || exit 1

GAMEDIR="/$directory/ports/$PORT_NAME"
[ -x "$GAMEDIR/bin/portkit-launcher" ] &&
  export PORTKIT_LAUNCHER_BIN_OVERRIDE="$GAMEDIR/bin/portkit-launcher"
portmaster_sync_launcher_artwork "$SCRIPT_DIR" "$0" "$SCRIPT_DIR"
CONFDIR="$GAMEDIR/conf"
SHADER_CACHE_DIR="/tmp/bogodroid-cache-com.poncle.vampiresurvivors/UnityShaderCache"
cd "$GAMEDIR"
exec > "$GAMEDIR/log.txt" 2>&1
echo "$LOG_PREFIX CFW=$CFW_NAME ${DISPLAY_WIDTH}x${DISPLAY_HEIGHT} GAMEDIR=$GAMEDIR"
mkdir -p "$CONFDIR" "$SHADER_CACHE_DIR"

# ── shared helpers (assemble.sh inlines these into the device build) ─────
#@KIT-BEGIN
KIT="$(cd "$(dirname "$0")/../../../_kit" && pwd)"
source "$KIT/portmaster_common.sh"
source "$KIT/launcher_unity_common.sh"
#@KIT-END

trap launcher_platform_release_display EXIT INT TERM
launcher_platform_acquire_display

resolve_port_toml
grep -Eq '^[[:space:]]*unity_shader_cache_redirect[[:space:]]*=' "$PORT_TOML" || {
  echo "$LOG_PREFIX missing paths.unity_shader_cache_redirect in $PORT_TOML"
  exit 1
}

# ═══════════════ STAGE 1: love settings UI → writes launch_config.env ════
# Shared logic lives in _kit (fonts / display / gptokeyb / exit-code gating);
# exit=0 does pm_finish;exit internally.
run_love_launcher_ui

VS_ENV="$LAUNCH_ENV"
if [ -f "$VS_ENV" ]; then
  source "$VS_ENV"
  echo "$LOG_PREFIX env: output=${VS_WIDTH}x${VS_HEIGHT} render_percent=${VS_RENDER_PERCENT:-100} swap_ab=$VS_SWAP_AB swap_xy=$VS_SWAP_XY"

  if [ "$VS_SWAP_AB" = "on" ]; then A_V=BUTTON_B; B_V=BUTTON_A; else A_V=BUTTON_A; B_V=BUTTON_B; fi
  if [ "$VS_SWAP_XY" = "on" ]; then X_V=BUTTON_Y; Y_V=BUTTON_X; else X_V=BUTTON_X; Y_V=BUTTON_Y; fi
  apply_button_remap "$PORT_TOML" "$A_V" "$B_V" "$X_V" "$Y_V"
else
  echo "$LOG_PREFIX no launch_config.env — panel resolution, current config.toml otherwise"
fi

# Outside the env branch on purpose: without a launcher UI there is no env, and
# the resolution must still follow this device's panel.
configure_unity_display "$PORT_TOML" "${VS_WIDTH:-auto}" "${VS_HEIGHT:-auto}" "${VS_RENDER_PERCENT:-100}" || exit 1

# Unity Loader now resolves Android base assets and Play Asset Delivery pack
# assets internally. Keep the launcher focused on UI/config; do not bind
# gamedata/assets or Addressables aa here.

# ── Safe GL defaults ─────────────────────────────────────────────────────
# Keep the real Mali context intact, but advertise ES 3.0 to Unity. Unity 6's
# ES 3.2 world-rendering path only fills a small lower-left region on the
# MiniLoong Mali-G52, while its ES 3.0 path renders the complete frame.
sed -i "s/^glVersionOverride.*/glVersionOverride        = \"OpenGL ES 3.0 Bogodroid\"/" "$PORT_TOML"
sed -i "s/^glMajorVersionOverride.*/glMajorVersionOverride   = 3/" "$PORT_TOML"
sed -i "s/^glMinorVersionOverride.*/glMinorVersionOverride   = 0/" "$PORT_TOML"
# Rewriting Unity's live ES 3 blit pair as ES 2 produces an opaque black
# backbuffer on the MiniLoong Mali driver. Driver workarounds remain active;
# only the destructive source translation is disabled for this port.
sed -i "s/^shaderGles2Rewrite *=.*/shaderGles2Rewrite = false/" "$PORT_TOML"
sed -i "s/^textureMaxDim *=.*/textureMaxDim = 0/" "$PORT_TOML"

# Rewired 1.1.58 disables Unity input for this Android build, while its native
# Android helper cannot initialize without a real Android runtime. Keep the
# Android gamepad visible to Bogodroid, and add a per-game keyboard bridge for
# the UI actions Rewired still consumes. This is deliberately not the LÖVE UI
# mapping: B remains Back, and the launcher's AB preference is preserved.
if [ "${VS_SWAP_AB:-off}" = "on" ]; then
  export UNITY_GAME_GPTK_CONFIG="$GAMEDIR/vampiresurvivors114-game-swap-ab.gptk"
else
  export UNITY_GAME_GPTK_CONFIG="$GAMEDIR/vampiresurvivors114-game.gptk"
fi

# Unity 6/PAD compatibility is handled by unityloader.d plugins. The second
# argument only supplies this game's packaged native-library directories;
# process orchestration remains shared with every other Unity port.
run_unity_game "$PORT_TOML" "$GAMEDIR/gamedata/lib:$GAMEDIR/gamedata/lib/arm64-v8a"
