import hashlib,json,re,stat,struct,sys
from pathlib import Path
bundle, identity, original = Path(sys.argv[1]),sys.argv[2],Path(sys.argv[3])
baseline=original/'data_sts2_linuxbsd_arm64'
def digest(path):
    h=hashlib.sha256()
    with path.open('rb') as stream:
        for block in iter(lambda:stream.read(1024*1024),b''): h.update(block)
    return h.hexdigest()
def regular(path):
    if path.is_symlink() or not path.is_file() or path.stat().st_nlink != 1: raise ValueError('not a regular file: '+str(path))
def safe_name(name):
    return isinstance(name,str) and name not in ('','.','..') and '/' not in name and '\\' not in name
try:
    if bundle.is_symlink() or not bundle.is_dir(): raise ValueError('invalid build directory')
    regular(bundle/'manifest.json'); raw=(bundle/'manifest.json').read_bytes()
    if hashlib.sha256(raw).hexdigest()!=identity: raise ValueError('build manifest checksum mismatch')
    manifest=json.loads(raw)
    fields={'source_pck_sha256','main_sha256','main_bytes','patch_sha256','game_files','release_sha256','entry_sha256','runtime_binding','baseline_files','extension_files'}
    if set(manifest) not in (fields,fields|{'engine_sha256'}): raise ValueError('unexpected build manifest')
    if 'engine_sha256' in manifest:
        engine=bundle/'engine.bin';regular(engine)
        if manifest['engine_sha256']!='93d0952f7b082e221b15eb2f060b20c0237aabf9fea6ec2639cf31d415ce7e9e' or digest(engine)!=manifest['engine_sha256']:raise ValueError('private engine mismatch')
    if not all(re.fullmatch('[0-9a-f]{64}',manifest[k]) for k in ('source_pck_sha256','main_sha256','patch_sha256','release_sha256','entry_sha256')): raise ValueError('invalid build hashes')
    patch=bundle/'patch';data=bundle/'data'
    if patch.is_symlink() or data.is_symlink() or not patch.is_dir() or not data.is_dir():raise ValueError('invalid bundle directories')
    regular(patch/'manifest.json');raw_patch=(patch/'manifest.json').read_bytes()
    if hashlib.sha256(raw_patch).hexdigest()!=manifest['patch_sha256']:raise ValueError('patch identity mismatch')
    p=json.loads(raw_patch)
    if set(p)!= {'files','source_files'} or set(p['files'])!={'sts2.dll','sts2.deps.json','sts2_compat.dll','port_compat.pck'} or set(p['source_files'])!={'sts2.dll','sts2.deps.json'}:raise ValueError('invalid patch manifest')
    if set(x.name for x in patch.iterdir())!=set(p['files'])|{'manifest.json'} or set(x.name for x in data.iterdir())!=set(manifest['game_files']):raise ValueError('unexpected bundle files')
    for folder,files in ((patch,p['files']),(data,manifest['game_files'])):
        if not isinstance(files,dict) or not files or any(not safe_name(n) for n in files):raise ValueError('invalid file manifest')
        for name,expected in files.items():
            path=folder/name;regular(path)
            if not isinstance(expected,str) or not re.fullmatch('[0-9a-f]{64}',expected) or digest(path)!=expected:raise ValueError('build file mismatch: '+name)
    for name,expected in p['source_files'].items():
        if manifest['game_files'].get(name)!=expected:raise ValueError('patch and game data disagree')
    release=bundle/'release_info.json';regular(release)
    if digest(release)!=manifest['release_sha256']:raise ValueError('release info mismatch')
    regular(bundle/'entry.sh')
    if digest(bundle/'entry.sh')!=manifest['entry_sha256']:raise ValueError('build entry mismatch')
    binding=manifest['runtime_binding']
    if set(binding)!={'sts2.deps.json','GodotSharp.dll'}:raise ValueError('invalid runtime binding')
    for name,expected in binding.items():
        path=baseline/name;regular(path)
        if digest(path)!=expected:raise ValueError('runtime source identity changed: '+name)
    main=bundle/'main.pck';regular(main)
    regular(bundle/'main.stat.json');side=json.loads((bundle/'main.stat.json').read_text())
    s=main.stat()
    if side!={'build_sha256':identity,'main_sha256':manifest['main_sha256'],'size':s.st_size,'mtime_ns':s.st_mtime_ns} or s.st_size!=manifest['main_bytes']:raise ValueError('main pack identity changed')
    with main.open('rb') as stream:
        if struct.unpack('<5I',stream.read(20))!=(0x43504447,3,4,5,1):raise ValueError('unsupported main pack')
    if not isinstance(manifest['baseline_files'],dict) or not manifest['baseline_files']:raise ValueError('missing runtime baseline')
    selected={p.name for p in baseline.iterdir() if p.is_file() and p.suffix in ('.dll','.json','.so','.dat') and p.name not in manifest['game_files'] and p.name not in ('sts2.dll','sts2_compat.dll','sts2.deps.json')}
    if selected != set(manifest['baseline_files']):raise ValueError('runtime baseline inventory changed')
    for name,expected in manifest['baseline_files'].items():
        if not safe_name(name):raise ValueError('invalid baseline file')
        path=baseline/name;regular(path);st=path.stat()
        if set(expected)!={'sha256','size','mtime_ns'} or {'size':st.st_size,'mtime_ns':st.st_mtime_ns}!={k:expected[k] for k in ('size','mtime_ns')}:raise ValueError('runtime baseline changed: '+name)
    extensions=manifest['extension_files']
    required={'addons/spine/linux/libspine_godot.linux.template_release.arm64.so','addons/fmod/libs/linux/libGodotFmod.linux.template_release.arm64.so',*[f'addons/fmod/libs/linux/{name}' for name in ('libfmod.so','libfmod.so.14','libfmod.so.14.6','libfmodstudio.so','libfmodstudio.so.14','libfmodstudio.so.14.6')]}
    if not isinstance(extensions,dict) or set(extensions)!=required:raise ValueError('invalid native extension inventory')
    for name,expected in extensions.items():
        path=original/name;regular(path);st=path.stat()
        if set(expected)!={'sha256','size','mtime_ns'} or {'size':st.st_size,'mtime_ns':st.st_mtime_ns}!={k:expected[k] for k in ('size','mtime_ns')}:raise ValueError('native extension changed: '+name)
    print('[STS2-VK] verified atomic game build '+identity[:12])
except (OSError,ValueError,KeyError,TypeError,struct.error) as exc:
    raise SystemExit('[STS2-VK] invalid game build: '+str(exc))
VERIFY_BUILD
  PRIVATE_ENGINE="$(python3 - "$BUILD_DIR/manifest.json" "$BUILD_DIR/engine.bin" <<'PRIVATE_ENGINE_PATH'
import json,sys
m=json.load(open(sys.argv[1]))
print(sys.argv[2] if 'engine_sha256' in m else '')
PRIVATE_ENGINE_PATH
)" || exit 1
  # Only the unified settings entry requests the original PortMaster runtime.
  # Legacy direct trial launches keep their installed engine and behavior.
  if [ "${SLL_LAUNCHER_HANDOFF:-0}" = 1 ]; then PRIVATE_ENGINE=""; fi
