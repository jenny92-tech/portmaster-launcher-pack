import hashlib
import os
from pathlib import Path
import runpy
import shutil
import stat
import subprocess
import sys
import tempfile

helper, image, image_hash, game, engine_hash, private_engine = sys.argv[1:]
game = Path(game)
engine = game / "godot.mono"
if engine.is_symlink():
    raise SystemExit("[STS2-VK] engine must not be a symlink")
def digest(path):
    result = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            result.update(block)
    return result.hexdigest()
if engine.is_file() and digest(engine) == engine_hash:
    sys.exit(0)
if private_engine:
    source=Path(private_engine)
    source_fd=os.open(source,os.O_RDONLY|os.O_NOFOLLOW)
    source_stat=os.fstat(source_fd)
    if not stat.S_ISREG(source_stat.st_mode) or source_stat.st_nlink != 1:
        os.close(source_fd);raise SystemExit('[STS2-VK] unsafe private engine')
    fd,incoming=tempfile.mkstemp(prefix='.godot-',dir=str(game))
    try:
        with os.fdopen(fd,'wb') as out, os.fdopen(source_fd,'rb') as inp:
            h=hashlib.sha256()
            for block in iter(lambda:inp.read(1024*1024),b''):
                h.update(block);out.write(block)
            after=os.fstat(inp.fileno());out.flush();os.fsync(out.fileno());os.fchmod(out.fileno(),0o755)
        if (source_stat.st_dev,source_stat.st_ino,source_stat.st_size,source_stat.st_mtime_ns)!=(after.st_dev,after.st_ino,after.st_size,after.st_mtime_ns) or h.hexdigest()!=engine_hash or digest(Path(incoming))!=engine_hash:raise ValueError('private engine copy mismatch')
        os.replace(incoming,engine)
    finally:
        if os.path.exists(incoming):os.unlink(incoming)
    sys.exit(0)
if digest(Path(image)) != image_hash:
    raise SystemExit("[STS2-VK] official PortMaster runtime checksum mismatch")
runpy.run_path(helper)["_unshare_mounts"]()
subprocess.run(["mount", "--make-rprivate", "/"], check=True)
mountpoint = game.parent / "runtime"
mountpoint.mkdir(exist_ok=True)
subprocess.run(["mount", "-t", "squashfs", "-o", "loop,ro,nodev,nosuid,exec",
                image, str(mountpoint)], check=True)
try:
    source = mountpoint / "godot45.mono.aarch64"
    if digest(source) != engine_hash:
        raise SystemExit("[STS2-VK] official Godot executable checksum mismatch")
    incoming = engine.with_suffix(".incoming")
    shutil.copyfile(source, incoming)
    incoming.chmod(0o755)
    os.replace(incoming, engine)
finally:
    subprocess.run(["umount", str(mountpoint)], check=True)
PY
