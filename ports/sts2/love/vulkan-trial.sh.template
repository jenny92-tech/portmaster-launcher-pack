  texture_id="$(cat "$TESTDIR/active-texture")" || { echo "$LOG_PREFIX cannot read texture marker"; exit 1; }
  case "$texture_id" in ''|*[!0-9a-f]*) echo "$LOG_PREFIX invalid active texture marker"; exit 1 ;; esac
  [ "${#texture_id}" = 64 ] || { echo "$LOG_PREFIX invalid active texture marker"; exit 1; }
  SLL_TEXTURE_MAIN_PACK="$TESTDIR/merged/$texture_id.pck"
fi
if [ -n "${SLL_TEXTURE_MAIN_PACK:-}" ]; then
  python3 - "$TESTDIR" "$MAIN_PACK" "$SLL_TEXTURE_MAIN_PACK" <<'VERIFY_TEXTURE' || exit 1
import json
from pathlib import Path
import re
import stat
import struct
import sys

testdir, source, selected = map(Path, sys.argv[1:])
try:
    merged = testdir / "merged"
    if not selected.is_absolute() or selected.parent != merged or not re.fullmatch(r"[0-9a-f]{64}\.pck", selected.name):
        raise ValueError("main pack path must name an installed merged PCK")
    if selected.is_symlink():
        raise ValueError("merged PCK must not be a symlink")
    with selected.open("rb") as stream:
        header = stream.read(20)
    if len(header) != 20 or struct.unpack("<5I", header) != (0x43504447, 3, 4, 5, 1):
        raise ValueError("unsupported merged PCK header")
    manifest = json.loads((merged / (selected.stem + ".json")).read_text(encoding="utf-8"))
    if set(manifest) != {"merged_sha256", "overlay_sha256", "source_sha256", "merged_stat", "source_stat"}:
        raise ValueError("invalid merged manifest")
    if manifest["merged_sha256"] != selected.stem or not all(re.fullmatch(r"[0-9a-f]{64}", manifest[key]) for key in ("overlay_sha256", "source_sha256")):
        raise ValueError("merged manifest identity mismatch")
    def identity(path):
        info = path.stat()
        if not stat.S_ISREG(info.st_mode):
            raise ValueError("not a regular file: " + str(path))
        return {"size": info.st_size, "mtime_ns": info.st_mtime_ns}
    if identity(selected) != manifest["merged_stat"] or identity(source) != manifest["source_stat"]:
        raise ValueError("merged or original PCK changed since installation")
except (OSError, ValueError, TypeError, KeyError) as exc:
    raise SystemExit("[STS2-VK] low texture verification failed: " + str(exc))
print("[STS2-VK] verified low texture main PCK " + selected.stem[:12])
VERIFY_TEXTURE
  MAIN_PACK="$SLL_TEXTURE_MAIN_PACK"
fi
fi
