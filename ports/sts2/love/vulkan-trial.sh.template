else
patch_id="$(cat "$TESTDIR/active-patch")" || exit 1
case "$patch_id" in ''|*[!0-9a-f]*) exit 1 ;; esac
[ "${#patch_id}" = 64 ] || exit 1
PATCHDIR="$TESTDIR/patches/$patch_id"
python3 - "$PATCHDIR" "$patch_id" "$ORIGINAL/data_sts2_linuxbsd_arm64" <<'VERIFY_PATCH' || exit 1
import hashlib
import json
from pathlib import Path
import sys

patch, patch_id, original = sys.argv[1:]
patch, original = Path(patch), Path(original)
raw = (patch / "manifest.json").read_bytes()
if hashlib.sha256(raw).hexdigest() != patch_id:
    raise SystemExit("[STS2-VK] patch manifest checksum mismatch")
manifest = json.loads(raw)
if set(manifest["files"]) != {"sts2.dll", "sts2_compat.dll", "sts2.deps.json", "port_compat.pck"}:
    raise SystemExit("[STS2-VK] unexpected patch payload")
if set(manifest["source_files"]) != {"sts2.dll", "sts2.deps.json"}:
    raise SystemExit("[STS2-VK] unexpected game input manifest")
for root, entries in ((patch, manifest["files"]), (original, manifest["source_files"])):
    for name, expected in entries.items():
        if hashlib.sha256((root / name).read_bytes()).hexdigest() != expected:
            raise SystemExit("[STS2-VK] game/patch checksum mismatch: " + name)
print("[STS2-VK] verified game-side performance patch " + patch_id[:12])
VERIFY_PATCH
# Select the verified low-texture main PCK before Godot parses its main scene.
if [ -n "${SLL_TEXTURE_OVERLAY:-}" ]; then
