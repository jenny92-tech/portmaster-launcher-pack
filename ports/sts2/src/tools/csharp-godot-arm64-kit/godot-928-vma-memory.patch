+			for (uint32_t i = 0; i < properties->memoryHeapCount; i++) {
+				const VmaStatistics &s = stats.memoryHeap[i].statistics;
+				print_line(vformat("VMA_STATS heap=%d size=%d flags=%d block_bytes=%d allocation_bytes=%d blocks=%d allocations=%d", i, properties->memoryHeaps[i].size, properties->memoryHeaps[i].flags, s.blockBytes, s.allocationBytes, s.blockCount, s.allocationCount));
+			}
+			for (uint32_t i = 0; i < properties->memoryTypeCount; i++) {
