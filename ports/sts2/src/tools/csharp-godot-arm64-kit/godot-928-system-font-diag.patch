+			};
+#endif
 
 			SystemFontCacheRec sysf;
 			sysf.rid = _create_font();
 			_font_set_data_ptr(sysf.rid, font_data.ptr(), font_data.size());
 			if (!_font_validate(sysf.rid)) {
+#ifdef GODOT_MODULE
+				diag_log("<invalid-font>");
