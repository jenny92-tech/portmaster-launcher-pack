 				if (unlikely(!_font_has_char(sysf.rid, p_text[0]))) {
@@ -5686,16 +5729,30 @@ RID TextServerAdvanced::_find_sys_font_for_text(const RID &p_fdef, const String
 				if (score >= best_score) {
 					best_score = score;
 					best_match = face_idx;
+#ifdef GODOT_MODULE
+					if (diag_miss) {
+						// Style/weight queries above already initialized this face.
+						diag_best_family = _font_get_name(sysf.rid);
+					}
+#endif
 				}
 				if (best_score == 70) {
 					break;
 				}
 			}
 			if (best_match == -1) {
+#ifdef GODOT_MODULE
+				diag_log("<no-matching-face>");
+#endif
 				_free_rid(sysf.rid);
