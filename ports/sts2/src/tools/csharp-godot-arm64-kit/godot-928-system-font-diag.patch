 				}
 			}
 
+#ifdef GODOT_MODULE
+			bool diag_miss = false;
+			uint64_t diag_entries = 0;
+			uint64_t diag_bytes = 0;
+#endif
 			if (!system_font_data.has(E)) {
 				system_font_data[E] = FileAccess::get_file_as_bytes(E);
+#ifdef GODOT_MODULE
+				// Freeze the opt-in at the first miss, so totals cover this cache.
+				static const bool diag_enabled = OS::get_singleton()->get_environment("SLL_SYSTEM_FONT_DIAG") == "1";
+				if (diag_enabled) {
+					MutexLock diag_lock(system_font_diag_mutex);
+					diag_miss = true;
+					diag_entries = ++system_font_diag_entries;
+					system_font_diag_bytes += system_font_data[E].size();
+					diag_bytes = system_font_diag_bytes;
+				}
+#endif
 			}
 
 			const PackedByteArray &font_data = system_font_data[E];
+#ifdef GODOT_MODULE
+			auto diag_log = [&](const String &p_family) {
+				if (!diag_miss) {
+					return;
+				}
+				auto token = [](const String &p_value, int p_limit) {
+					String out;
+					for (int i = 0; i < p_value.length() && out.length() < p_limit; i++) {
+						char32_t ch = p_value[i];
+						if (ch < 32 || ch == 127 || ch == '/' || ch == '\\' || ch == '"') {
+							ch = '_';
+						}
+						out += ch;
+					}
+					return out;
+				};
