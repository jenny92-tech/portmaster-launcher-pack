+/* Project handheld startup notification. Process creation or vkQueuePresent
+ * alone is not a compositor frame callback. */
+static void notify_startup_frame()
+{
+   const char *token = std::getenv("WINE_RUNNER_PRESENT_TOKEN");
+   if (token == nullptr || std::strlen(token) != 32 || std::strspn(token, "0123456789abcdef") != 32)
+      return;
+   static std::atomic_bool notified{false};
+   if (notified.exchange(true))
+      return;
+   const int fd = open("/work/presentation-ready", O_WRONLY | O_CREAT | O_TRUNC | O_NOFOLLOW | O_NONBLOCK, 0600);
+   if (fd < 0)
+      return;
+   char message[40] = "frame ";
+   std::memcpy(message + 6, token, 32);
+   message[38] = '\n';
+   const auto written = write(fd, message, 39);
+   UNUSED(written);
+   close(fd);
+}
