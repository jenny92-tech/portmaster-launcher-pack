{
  "display_name": "MiniLoong Pocket One (LoongOS)",
  "device_manufacturer": "MiniLoong",
  "priority": 1010,
  "support": {
    "device_class": "tested",
    "target_confirmation": "detected"
  },
  "recognition": {
    "kind": "all",
    "predicates": [
      {
        "kind": "os_release_equals",
        "field": "ID",
        "value": "loong",
        "case_insensitive": true
      },
      {
        "kind": "os_release_version_at_least",
        "field": "VERSION_ID",
        "value": "1.4.0.0"
      }
    ]
  },
  "required_adapters": [
    "predicate.v1",
    "path.v1",
    "frontend.v1",
    "library.v1",
    "python.v1"
  ],
  "paths": {
    "scripts": {
      "strategy": "launcher_dir"
    },
    "launcher_directory": {
      "strategy": "launcher_dir"
    },
    "game_data": {
      "strategy": "literal",
      "value": "/roms/ports"
    },
    "portmaster_core": {
      "strategy": "relative_to",
      "base": "game_data",
      "suffix": "PortMaster",
      "canonicalize_existing": true
    },
    "frontend": {
      "strategy": "launcher_dir"
    },
    "images": {
      "strategy": "relative_to",
      "base": "scripts",
      "suffix": "images"
    }
  },
  "source_route": "miniloong-custom",
  "frontend": {
    "management": "app",
    "kind": "script-internal",
    "names": [
      "PortMaster.sh"
    ],
    "primary": "PortMaster.sh",
    "control_source": null,
    "core_launcher_source": null,
    "remove_core_launcher": false,
    "empty_tasksetter": false,
    "core_executable": "PortMaster.sh",
    "frontend_executable": "PortMaster.sh",
    "install_map": [
      {
        "source": "miniloong/PortMaster.txt",
        "target": "PortMaster.sh",
        "executable": true
      }
    ]
  },
  "libraries": {
    "groups": {
      "sdl2": {
        "required_sonames": [
          "libSDL2-2.0.so.0",
          "libSDL2_image-2.0.so.0",
          "libSDL2_mixer-2.0.so.0",
          "libSDL2_ttf-2.0.so.0"
        ],
        "candidates": [
          "/usr/lib"
        ]
      },
      "gles": {
        "required_sonames": [
          "libGLESv2.so"
        ],
        "candidates": [
          "/usr/lib"
        ]
      }
    }
  },
  "python": {
    "mode": "runtime_mount",
    "runtime": "python_3.11"
  },
  "health": [
    {
      "kind": "required_file",
      "path": "{portmaster_core}/control.txt"
    },
    {
      "kind": "required_file",
      "path": "{portmaster_core}/device_info.txt"
    },
    {
      "kind": "required_file",
      "path": "{portmaster_core}/funcs.txt"
    },
    {
      "kind": "one_of_files",
      "paths": [
        "{portmaster_core}/pugwash",
        "{portmaster_core}/harbourmaster"
      ]
    },
    {
      "kind": "executable_file",
      "path": "{portmaster_core}/PortMaster.sh"
    },
    {
      "kind": "archive_or_nonempty_directory",
      "archive": "{portmaster_core}/pylibs.zip",
      "directory": "{portmaster_core}/pylibs"
    },
    {
      "kind": "python_imports_or_runtime",
      "imports": [
        "sys",
        "encodings",
        "zipfile",
        "hashlib"
      ],
      "runtime": "python_3.11"
    }
  ],
  "preserved_dirs": [
    "libs",
    "config",
    "themes",
    "logs",
    "cache"
  ],
  "capabilities": {
    "manage_portmaster": true,
    "install_portmaster": true,
    "update_portmaster": true,
    "repair_runtimes": true,
    "manage_ports": true,
    "inventory_ports": true,
    "install_ports": true,
    "inventory_apps": false,
    "manage_apps": false,
    "install_apps": false,
    "manage_frontend": true,
    "manage_images": true,
    "manage_artwork": true,
    "trash": true,
    "leftovers": true,
    "cleanup_appledouble": true,
    "scan_script_images": true
  },
  "environment_scopes": [
    "love_ui"
  ],
  "display": {
    "default_width": 960,
    "default_height": 720
  },
  "input": {
    "analog_sticks": 2,
    "tty": "/dev/tty0"
  },
  "locations": [
    {
      "id": "ports-scripts",
      "kind": "port_scripts",
      "path": "scripts",
      "roles": [
        "inventory",
        "install",
        "manage",
        "trash",
        "trash_restore",
        "cleanup_apple_double"
      ],
      "formats": [
        "port"
      ],
      "priority": 100
    },
    {
      "id": "ports-data",
      "kind": "port_data",
      "path": "game_data",
      "roles": [
        "inventory",
        "install",
        "manage",
        "trash",
        "trash_restore",
        "cleanup_apple_double"
      ],
      "formats": [
        "port"
      ],
      "priority": 100
    },
    {
      "id": "ports-images",
      "kind": "port_images",
      "path": "images",
      "roles": [
        "inventory",
        "manage",
        "trash",
        "trash_restore",
        "cleanup_apple_double"
      ],
      "formats": [],
      "priority": 100
    }
  ]
}
