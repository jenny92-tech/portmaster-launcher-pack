{
 "display_name": "TrimUI",
 "device_manufacturer": "TrimUI",
 "priority": 900,
 "support": {
  "device_class": "tested",
  "target_confirmation": "detected"
 },
 "recognition": {
  "kind": "any",
  "predicates": [
   {
    "kind": "directory_exists",
    "path": "/usr/trimui"
   },
   {
    "kind": "env_equals",
    "name": "CFW_NAME",
    "value": "TrimUI"
   },
   {
    "kind": "launcher_path_prefix",
    "prefix": "/mnt/SDCARD/Roms/PORTS"
   }
  ]
 },
 "required_adapters": [
  "predicate.v1",
  "path.v1",
  "frontend.v1",
  "library.v1",
  "python.v1"
 ],
"paths": {
  "shell_directory": {"strategy": "parent", "of": "game_data"},
  "scripts": {
   "strategy": "launcher_dir"
  },
  "launcher_directory": {
   "strategy": "literal",
   "value": "/mnt/SDCARD/Data"
  },
  "game_data": {
   "strategy": "literal",
   "value": "/mnt/SDCARD/Data/ports"
  },
  "portmaster_core": {
   "strategy": "literal",
   "value": "/mnt/SDCARD/Apps/PortMaster/PortMaster"
  },
  "frontend": {
   "strategy": "literal",
   "value": "/mnt/SDCARD/Apps/PortMaster"
  },
  "images": {
   "strategy": "literal",
   "value": "/mnt/SDCARD/Imgs/PORTS"
  },
  "apps": {
   "strategy": "literal",
   "value": "/mnt/SDCARD/Apps"
  }
 },
 "source_route": "system",
 "frontend": {
  "management": "system",
  "kind": "trimui",
  "names": [
   "launch.sh",
   "config.json",
   "icon.png"
  ],
  "primary": "launch.sh",
  "control_source": "trimui/control.txt",
  "core_launcher_source": null,
  "remove_core_launcher": true,
  "empty_tasksetter": true,
  "core_executable": null,
  "frontend_executable": "launch.sh",
  "install_map": [
   {
    "source": "trimui/PortMaster.txt",
    "target": "launch.sh",
    "executable": true
   },
   {
    "source": "trimui/config.json",
    "target": "config.json",
    "executable": false
   },
   {
    "source": "trimui/icon.png",
    "target": "icon.png",
    "executable": false
   }
  ],
  "transforms": [
   {
    "kind": "export_library_group",
    "target": "launch.sh",
    "variable": "PYSDL2_DLL_PATH",
    "library_group": "sdl2"
   }
  ]
 },
 "libraries": {
  "groups": {
   "sdl2": {
    "required_sonames": [
     "libSDL2-2.0.so.0",
     "libSDL2_image-2.0.so.0",
     "libSDL2_mixer-2.0.so.0",
     "libSDL2_ttf-2.0.so.0"
    ],
    "candidates": [
     "/usr/lib",
     "/usr/trimui/lib"
    ]
   },
   "gles": {
    "required_sonames": [
     "libGLESv2.so"
    ],
    "candidates": [
     "/usr/lib"
    ]
   }
  }
 },
 "python": {
  "mode": "system",
  "imports": [
   "sys",
   "encodings",
   "zipfile",
   "hashlib"
  ]
 },
 "health": [
  {
   "kind": "required_file",
   "path": "{portmaster_core}/control.txt"
  },
  {
   "kind": "required_file",
   "path": "{portmaster_core}/device_info.txt"
  },
  {
   "kind": "required_file",
   "path": "{portmaster_core}/funcs.txt"
  },
  {
   "kind": "one_of_files",
   "paths": [
    "{portmaster_core}/pugwash",
    "{portmaster_core}/harbourmaster"
   ]
  },
  {
   "kind": "archive_or_nonempty_directory",
   "archive": "{portmaster_core}/pylibs.zip",
   "directory": "{portmaster_core}/pylibs"
  },
  {
   "kind": "python_imports_or_runtime",
   "imports": [
    "sys",
    "encodings",
    "zipfile",
    "hashlib"
   ]
  }
 ],
 "preserved_dirs": [
  "libs",
  "config",
  "themes",
  "logs",
  "cache"
 ],
 "capabilities": {
  "manage_portmaster": false,
  "install_portmaster": false,
  "update_portmaster": false,
  "repair_runtimes": true,
  "manage_ports": true,
  "inventory_ports": true,
  "install_ports": true,
  "inventory_apps": true,
  "manage_apps": true,
  "install_apps": true,
  "manage_frontend": false,
  "manage_images": true,
  "manage_artwork": true,
  "trash": true,
  "leftovers": true,
  "cleanup_appledouble": true,
  "scan_script_images": false
 },
 "environment_scopes": [
  "love_ui"
 ],
 "display": {
  "default_width": 1280,
  "default_height": 720
 },
 "input": {
  "analog_sticks": 2,
  "tty": "/dev/tty0"
 },
 "models": [
  {
   "id": "brick",
   "priority": 100,
   "display_name": "TrimUI Brick",
   "recognition": {
    "kind": "env_equals",
    "name": "DEVICE",
    "value": "brick",
    "case_insensitive": true
   },
   "display": {
    "default_width": 1024,
    "default_height": 768
   },
   "overrides": {
    "input": {
     "analog_sticks": 0
    }
   }
  },
  {
   "id": "brick_pro",
   "priority": 100,
   "display_name": "TrimUI Brick Pro",
   "recognition": {
    "kind": "env_equals",
    "name": "DEVICE",
    "value": "brick-pro",
    "case_insensitive": true
   },
   "display": {
    "default_width": 1024,
    "default_height": 768
   },
   "overrides": {
    "input": {
     "analog_sticks": 2
    }
   }
  },
  {
   "id": "smart_pro",
   "priority": 100,
   "display_name": "TrimUI Smart Pro",
   "recognition": {
    "kind": "env_equals",
    "name": "DEVICE",
    "value": "smart-pro",
    "case_insensitive": true
   },
   "display": {
    "default_width": 1280,
    "default_height": 720
   },
   "overrides": {
    "input": {
     "analog_sticks": 2
    }
   }
  }
 ],
 "locations": [
  {"id":"ports-scripts","kind":"port_scripts","path":"scripts","roles":["inventory","install","manage","trash","trash_restore","cleanup_apple_double"],"formats":["port"],"priority":100},
  {"id":"ports-data","kind":"port_data","path":"game_data","roles":["inventory","install","manage","trash","trash_restore","cleanup_apple_double"],"formats":["port"],"priority":100},
  {"id":"ports-images","kind":"port_images","path":"images","roles":["inventory","manage","trash","trash_restore","cleanup_apple_double"],"formats":[],"priority":100},
  {"id":"apps-primary","kind":"apps","path":"apps","roles":["inventory","install","manage","trash","trash_restore","cleanup_apple_double"],"formats":["trimui_app"],"priority":100}
 ]
}
