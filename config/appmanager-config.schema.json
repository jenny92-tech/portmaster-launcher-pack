{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jenny92-tech/portmaster-launcher-pack/main/config/appmanager-config.schema.json",
  "title": "Port App Manager device configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "config_version",
    "metadata",
    "parser_limits",
    "bootstrap",
    "sources",
    "environment",
    "adapters",
    "platforms"
  ],
  "properties": {
    "format": {
      "const": "jenny92.appmanager-config"
    },
    "schema_version": {
      "const": 1
    },
    "config_version": {
      "$ref": "#/$defs/semver"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generated_at",
        "source_revision"
      ],
      "properties": {
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "source_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "parser_limits": {
      "type": "object",
      "description": "Resource limits intentionally omit a total file-size cap.",
      "additionalProperties": false,
      "required": [
        "max_depth",
        "max_path_bytes",
        "max_string_bytes",
        "max_collection_items"
      ],
      "properties": {
        "max_depth": {
          "type": "integer",
          "minimum": 1
        },
        "max_path_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_string_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_collection_items": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "bootstrap": {
      "$ref": "#/$defs/bootstrap"
    },
    "sources": {
      "$ref": "#/$defs/sources"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "adapters": {
      "type": "object",
      "description": "Unknown adapter definitions are retained for unrelated platforms; engines check only the resolved closure.",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/adapter"
      }
    },
    "platforms": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/platformEntry"
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "platformEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority",
        "recognition",
        "detail"
      ],
      "properties": {
        "priority": {
          "type": "integer"
        },
        "recognition": {
          "$ref": "#/$defs/predicate"
        },
        "detail": {
          "$ref": "#/$defs/detailArtifact"
        }
      }
    },
    "detailArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256", "bytes"],
      "properties": {
        "ref": {"type":"string","pattern":"^\\./platforms/[a-z][a-z0-9_.-]{0,127}\\.json$"},
        "sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
        "bytes": {"type":"integer","minimum":1}
      }
    },
    "openObject": {
      "type": "object"
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "config_url", "fallback", "transport", "required_format"],
      "properties": {
        "policy": {"const": "remote_then_embedded"},
        "config_url": {
          "type": "string",
          "pattern": "^https://raw\\.githubusercontent\\.com/\\S+$"
        },
        "fallback": {"const": "embedded_root_then_local_dir"},
        "transport": {"const": "github_https"},
        "required_format": {"const": "jenny92.appmanager-config"}
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoints", "release_routes", "runtime", "transport"],
      "properties": {
        "endpoints": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {
            "type": "string",
            "pattern": "^https://github\\.com/\\S+$"
          }
        },
        "release_routes": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {"$ref": "#/$defs/releaseRoute"}
        },
        "runtime": {"$ref": "#/$defs/runtimeSource"},
        "transport": {"$ref": "#/$defs/sourceTransport"}
      }
    },
    "releaseRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "channel", "archive_name", "checksum"],
      "properties": {
        "manifest": {"$ref": "#/$defs/id"},
        "channel": {"const": "stable"},
        "archive_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\\\s]+$"
        },
        "checksum": {"const": "md5_from_manifest"},
        "install_allowed": {"type": "boolean"}
      }
    },
    "runtimeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metadata", "architectures", "verification"],
      "properties": {
        "metadata": {"$ref": "#/$defs/id"},
        "architectures": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/runtimeArchitecture"}
        },
        "verification": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["url", "size", "md5", "squashfs_magic"]}
        }
      }
    },
    "runtimeArchitecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "system_names"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "system_names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          }
        }
      }
    },
    "sourceTransport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proxy_registry_ref", "probe_batch_limit", "capabilities", "routes",
        "cache_scope", "resume_requires_same_formatted_endpoint"
      ],
      "properties": {
        "proxy_registry_ref": {"const": "embedded://github-proxy-registry/v1"},
        "probe_batch_limit": {"type": "integer", "minimum": 1, "maximum": 32},
        "capabilities": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {"enum": ["release", "raw", "archive", "api", "gist", "clone"]}
        },
        "routes": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {"const": "release"}
        },
        "cache_scope": {"const": "process"},
        "resume_requires_same_formatted_endpoint": {"const": true}
      }
    },
    "adapter": {
      "type": "object",
      "required": [
        "kind",
        "contract_version"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "contract_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "environmentOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "name"
      ],
      "properties": {
        "operation": {
          "enum": [
            "set",
            "prepend",
            "append",
            "unset"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "value": {
          "type": "string"
        },
        "separator": {
          "type": "string",
          "maxLength": 4
        }
      }
    },
    "environmentScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profiles",
        "operations"
      ],
      "properties": {
        "profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/environmentOperation"
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inherit",
        "blocked_names",
        "blocked_prefixes",
        "value_handling",
        "operation_kinds",
        "profiles",
        "scopes"
      ],
      "properties": {
        "inherit": {
          "const": "all_except_blocked"
        },
        "blocked_names": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "enum": [
              "LD_PRELOAD",
              "LD_AUDIT",
              "GCONV_PATH",
              "BASH_ENV",
              "ENV",
              "SHELLOPTS",
              "BASHOPTS",
              "IFS",
              "PS4"
            ]
          }
        },
        "blocked_prefixes": {
          "const": [
            "BASH_FUNC_"
          ]
        },
        "value_handling": {
          "const": "literal"
        },
        "operation_kinds": {
          "const": [
            "set",
            "prepend",
            "append",
            "unset"
          ]
        },
        "profiles": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/environmentOperation"
            }
          }
        },
        "scopes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "love_ui"
          ],
          "properties": {
            "love_ui": {
              "$ref": "#/$defs/environmentScope"
            }
          }
        }
      }
    },
    "predicate": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "always",
            "all",
            "any",
            "directory_exists",
            "env_equals",
            "file_exists",
            "launcher_path_prefix",
            "os_release_equals",
            "os_release_version_at_least"
          ]
        },
        "predicates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/predicate"
          }
        },
        "path": {
          "$ref": "#/$defs/absolutePath"
        },
        "prefix": {
          "$ref": "#/$defs/absolutePath"
        },
        "field": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "case_insensitive": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/(?!.*(?:^|/)\\.\\.?/)(?!.*//)[^\\u0000\\r\\n]+$"
    },
    "pathStrategy": {
      "type": "object",
      "required": [
        "strategy"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "first_existing",
            "launcher_dir",
            "literal",
            "literal_by_launcher_prefix",
            "parent",
            "platform_core",
            "relative_to",
            "rom_root_from_launcher",
            "xdg_data_home"
          ]
        },
        "value": {
          "$ref": "#/$defs/absolutePath"
        },
        "prefix": {
          "$ref": "#/$defs/absolutePath"
        },
        "matched": {
          "$ref": "#/$defs/absolutePath"
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/absolutePath"
          }
        },
        "fallback": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/absolutePath"
          }
        },
        "on_missing": {
          "const": "unresolved"
        },
        "expected_type": {
          "enum": ["directory", "file"]
        },
        "levels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "base": {
          "$ref": "#/$defs/id"
        },
        "of": {
          "$ref": "#/$defs/id"
        },
        "suffix": {
          "type": "string",
          "pattern": "^[^/](?:.*[^/])?$"
        },
        "canonicalize_existing": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"strategy": {"const": "first_existing"}}},
          "then": {"required": ["candidates", "expected_type"]}
        }
      ]
    },
    "healthRule": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "archive_or_nonempty_directory",
            "executable_file",
            "one_of_files",
            "python_imports_or_runtime",
            "required_file"
          ]
        },
        "path": {
          "type": "string"
        },
        "archive": {
          "type": "string"
        },
        "directory": {
          "type": "string"
        },
        "imports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runtime": {
          "type": "string"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {"required": ["kind", "path"], "properties": {"kind": {"const": "required_file"}}},
        {"required": ["kind", "path"], "properties": {"kind": {"const": "executable_file"}}},
        {"required": ["kind", "paths"], "properties": {"kind": {"const": "one_of_files"}, "paths": {"minItems": 1}}},
        {"required": ["kind", "archive", "directory"], "properties": {"kind": {"const": "archive_or_nonempty_directory"}}},
        {
          "required": ["kind"],
          "properties": {"kind": {"const": "python_imports_or_runtime"}, "imports": {"minItems": 1}, "runtime": {"minLength": 1}},
          "anyOf": [{"required": ["imports"]}, {"required": ["runtime"]}]
        }
      ]
    },
    "frontendInstallItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target",
        "executable"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "pattern": "^[^/]+$"
        },
        "executable": {
          "type": "boolean"
        }
      }
    },
    "frontendTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target",
        "variable",
        "library_group"
      ],
      "properties": {
        "kind": {
          "const": "export_library_group"
        },
        "target": {
          "type": "string",
          "pattern": "^[^/]+$"
        },
        "variable": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "library_group": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "management",
        "kind",
        "names",
        "primary",
        "control_source",
        "core_launcher_source",
        "remove_core_launcher",
        "empty_tasksetter",
        "core_executable",
        "frontend_executable",
        "install_map"
      ],
      "properties": {
        "management": {
          "enum": [
            "app",
            "system"
          ]
        },
        "kind": {
          "enum": [
            "script-internal",
            "script-external",
            "control-internal",
            "core-internal",
            "trimui"
          ]
        },
        "names": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[^/]+$"
          }
        },
        "primary": {
          "type": "string",
          "pattern": "^[^/]+$"
        },
        "control_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "core_launcher_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "remove_core_launcher": {
          "type": "boolean"
        },
        "empty_tasksetter": {
          "type": "boolean"
        },
        "core_executable": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[^/]+$"
        },
        "frontend_executable": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[^/]+$"
        },
        "install_map": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frontendInstallItem"
          }
        },
        "transforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frontendTransform"
          }
        }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_class",
        "target_confirmation"
      ],
      "properties": {
        "device_class": {
          "enum": [
            "tested",
            "official-untested",
            "unsupported-known"
          ]
        },
        "target_confirmation": {
          "enum": [
            "detected",
            "existing_core_or_override"
          ]
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name",
        "priority",
        "support",
        "recognition",
        "required_adapters",
        "paths",
        "source_route",
        "frontend",
        "libraries",
        "python",
        "health",
        "preserved_dirs",
        "locations",
        "capabilities",
        "environment_scopes",
        "display",
        "input"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "device_manufacturer": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "integer"
        },
        "support": {
          "$ref": "#/$defs/support"
        },
        "recognition": {
          "$ref": "#/$defs/predicate"
        },
        "required_adapters": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "paths": {
          "type": "object",
          "required": [
            "launcher_directory"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/pathStrategy"
          }
        },
        "source_route": {
          "$ref": "#/$defs/id"
        },
        "frontend": {
          "$ref": "#/$defs/frontend"
        },
        "libraries": {
          "$ref": "#/$defs/openObject"
        },
        "python": {
          "$ref": "#/$defs/openObject"
        },
        "health": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/healthRule"
          }
        },
        "preserved_dirs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[^/]+$"
          }
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "environment_scopes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "love_ui"
            ]
          }
        },
        "display": {
          "$ref": "#/$defs/openObject"
        },
        "input": {
          "$ref": "#/$defs/openObject"
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/model"
          },
          "default": []
        },
        "locations": {
          "$ref": "#/$defs/locations"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "required": [
        "install_portmaster",
        "update_portmaster",
        "repair_runtimes",
        "manage_portmaster",
        "manage_ports",
        "inventory_ports",
        "install_ports",
        "inventory_apps",
        "manage_apps",
        "install_apps",
        "manage_artwork",
        "manage_frontend",
        "manage_images",
        "trash",
        "leftovers",
        "cleanup_appledouble",
        "scan_script_images"
      ],
      "propertyNames": {"$ref":"#/$defs/id"},
      "additionalProperties": {"type":"boolean"}
    },
    "locations": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref":"#/$defs/location"},
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["kind"],
            "properties": {"kind": {"const": "port_scripts"}}
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["kind"],
            "properties": {"kind": {"const": "port_data"}}
          },
          "minContains": 1
        }
      ],
      "x-appmanager-unique-highest-priority-by-kind": [
        "port_scripts", "port_data", "port_images"
      ],
      "x-appmanager-required-roles": {
        "inventory_ports": "inventory",
        "install_ports": "install",
        "manage_ports": "manage",
        "trash": ["trash", "trash_restore"],
        "cleanup_appledouble": "cleanup_apple_double"
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "roles", "formats", "priority"],
      "properties": {
        "id": {"$ref":"#/$defs/id"},
        "kind": {"enum":["port_scripts","port_data","port_images","apps"]},
        "path": {"$ref":"#/$defs/id"},
        "roles": {
          "type":"array",
          "minItems":1,
          "uniqueItems":true,
          "items": {
            "enum":["inventory","install","manage","trash","trash_restore","cleanup_apple_double"]
          }
        },
        "formats": {
          "type": "array",
          "uniqueItems":true,
          "items":{"enum":["port","trimui_app"]}
        },
        "priority":{"type":"integer"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "priority",
        "display_name",
        "recognition",
        "display"
      ],
      "properties": {
        "id": {"$ref":"#/$defs/id"},
        "priority": {"type":"integer"},
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "device_manufacturer": {
          "type": "string",
          "minLength": 1
        },
        "recognition": {
          "$ref": "#/$defs/predicate"
        },
        "display": {
          "$ref": "#/$defs/openObject"
        },
